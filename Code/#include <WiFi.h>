#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

const char* ssid = "SUNJAE";
const char* password = "jh9989jh@@";

IPAddress local_IP(192, 168, 252, 39);
IPAddress gateway(192, 168, 252, 1);
IPAddress subnet(255, 255, 255, 0);

WebServer server(80);

int messageCount = 0;

Servo servo1;
Servo servo2;
Servo servo3;
Servo servo4;
Servo servo5;  

const int servoPin1 = 25;
const int servoPin2 = 33;
const int servoPin3 = 27;
const int servoPin4 = 26;
const int servoPin5 = 32;

int servoAngle1 = 90;
int servoAngle2 = 90;
int servoAngle3 = 90;
int servoAngle4 = 90;
int servoAngle5 = 90;

const int SERVO_MIN_ANGLE = 0;
const int SERVO_MAX_ANGLE = 180;

void handleSet();

void setServo1Angle(int angle);
void setServo2Angle(int angle);
void setServo3Angle(int angle);
void setServo4Angle(int angle);
void setServo5Angle(int angle);   

void setServo1ByRoll(float roll);
void setServo2ByPitch(float pitch);
void setServo3ByLeft(float left);
void setServo5ByX(float x);

void setup() {
  Serial.begin(115200);

  WiFi.config(local_IP, gateway, subnet);

  servo1.setPeriodHertz(50);
  servo2.setPeriodHertz(50);
  servo3.setPeriodHertz(50);
  servo4.setPeriodHertz(50);
  servo5.setPeriodHertz(50);  

  servo1.attach(servoPin1, 500, 2400);
  servo2.attach(servoPin2, 500, 2400);
  servo3.attach(servoPin3, 500, 2400);
  servo4.attach(servoPin4, 500, 2400);
  servo5.attach(servoPin5, 500, 2400);

  servo1.write(servoAngle1);
  servo2.write(servoAngle2);
  servo3.write(servoAngle3);
  servo4.write(servoAngle4);
  servo5.write(servoAngle5);

  WiFi.begin(ssid, password);

  Serial.print("WiFi 연결중");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi 연결 완료");

  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());

  server.on("/set", handleSet);
  server.begin();

  Serial.println("HTTP 서버 시작");
}

void loop() {
  server.handleClient();
}

void setServo1Angle(int angle) {
  servoAngle1 = constrain(angle, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE);
  servo1.write(servoAngle1);
  Serial.print("servo1 angle: ");
  Serial.println(servoAngle1);
}

void setServo2Angle(int angle) {
  servoAngle2 = constrain(angle, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE);
  servo2.write(servoAngle2);
  Serial.print("servo2 angle: ");
  Serial.println(servoAngle2);
}

void setServo3Angle(int angle) {
  servoAngle3 = constrain(angle, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE);
  servo3.write(servoAngle3);
  Serial.print("servo3 angle: ");
  Serial.println(servoAngle3);
}

void setServo4Angle(int angle) {
  servoAngle4 = constrain(angle, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE);
  servo4.write(servoAngle4);
  Serial.print("servo4 angle: ");
  Serial.println(servoAngle4);
}

void setServo5Angle(int angle) {
  servoAngle5 = constrain(angle, SERVO_MIN_ANGLE, SERVO_MAX_ANGLE);
  servo5.write(servoAngle5);
  Serial.print("servo5 angle: ");
  Serial.println(servoAngle5);
}


void setServo1ByRoll(float roll) {
  float rollValue = constrain(roll, -90.0, 90.0);
  if (abs(rollValue) <= 10) {
    return;
  }
  float Kp = 1;

  int angleDelta = (int)round(Kp * rollValue);

  Serial.print("rollValue: ");
  Serial.print(rollValue);
  Serial.print(" angleDelta: ");
  Serial.println(angleDelta);


  // roll을 줄이는 방향으로 보정
  setServo1Angle(servoAngle1 + angleDelta);
}

void setServo2ByPitch(float pitch) {
  float pitchValue = constrain(pitch, -1, 1);
  if (abs(pitchValue) <= 0.1) {
    return;
  }

  float Kp_pitch = 45;
  // yaw 0.01당 Servo 2를 10도씩 현재 각도 기준으로 이동
  int angleDelta = (int)round(pitchValue * Kp_pitch);

  // 방향이 반대면 +를 -로 바꾸면 됨
  setServo2Angle(servoAngle2 + angleDelta);
}


void setServo3ByLeft(float left) {
  float leftValue = constrain(left, -10, 10);
  if (abs(leftValue) <= 0.1) {
    return;
  }

  float Kp_left = 1;

  int angleDelta = (int)round(leftValue * Kp_left);

  // 방향이 반대면 +를 -로 바꾸면 됨
  setServo3Angle(servoAngle3 + angleDelta);
}

void setServo5ByX(float x) {
  // x 입력값 제한
  float xValue = constrain(x, -225.0, 225.0);

  // x가 거의 0이면 움직이지 않음
  if (abs(xValue) <= 20.0) {
    return;
  }

  float Kp_x = 0.2;

  int angleDelta = (int)round(Kp_x * xValue);

  angleDelta = constrain(angleDelta, -10, 10);

  Serial.print("xValue: ");
  Serial.print(xValue);
  Serial.print(" x angleDelta: ");
  Serial.println(angleDelta);


  // x를 0으로 줄이는 방향으로 보정
  setServo5Angle(servoAngle5 - angleDelta);
}

void handleSet() {
  messageCount++;

  String x = server.arg("x");
  String y = server.arg("y");
  String yaw = server.arg("yaw");
  String pitch = server.arg("pitch");
  String roll = server.arg("roll");
  String command = server.arg("command");

  Serial.println();
  Serial.println("================================");
  Serial.print("MESSAGE #");
  Serial.println(messageCount);
  Serial.printf("#%d | x=%s y=%s yaw=%s pitch=%s roll=%s command=%s\n", messageCount, x.c_str(), y.c_str(), yaw.c_str(), pitch.c_str(), roll.c_str(), command.c_str());

  if (roll.length() > 0) {
    setServo1ByRoll(roll.toFloat());
  }

  // if (pitch.length() > 0) {
  //   setServo2ByPitch(pitch.toFloat());
  // }

  // if (y.length() > 0) {
  //   setServo3ByLeft(y.toFloat());
  // }

  if (x.length() > 0) {
  setServo5ByX(x.toFloat());
	}
  server.send(200, "text/plain", "OK");
}

